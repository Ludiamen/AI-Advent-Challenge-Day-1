# Скопируйте этот файл в .env и подставьте свой ключ:
#   cp .env.example .env
#
# .env добавлен в .gitignore и не попадёт в репозиторий.

DEEPSEEK_API_KEY=your-api-key-here

# Необязательные параметры (значения по умолчанию можно не менять).
# DEEPSEEK_MODEL — модель по умолчанию; в CLI/вебе её можно переключать
# (--model / селектор): deepseek-v4-flash или deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
